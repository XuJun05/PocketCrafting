{
	"schemaVersion": 1,
	"id": "pocketcrafting",
	"version": "1.2",
	"name": "PocketCrafting",
	"description": "This mod My Fast BTA mod.",
	"authors": [
		"XuJun05"
	],
	"contact": {
		"homepage": "https://www.planetminecraft.com/mod/pocketcrafting",
		"sources": "https://github.com/XuJun05/PocketCrafting",
		"issues": "https://github.com/XuJun05/PocketCrafting/issues"
	},
	"icon": "icon.png",
	"license": "GNU LGPL v3",
	"environment": "*",
	"entrypoints": {
		"main": [
			"gay.xujun05.pocketcrafting.PocketCrafting"
		],
		"afterItemInit": [
			"gay.xujun05.pocketcrafting.PocketItems"
		],
		"afterGameStart": [
			"gay.xujun05.pocketcrafting.PocketCrafting"
		],
		"recipesReady": [
			"gay.xujun05.pocketcrafting.PocketCrafting"
		],
		"initModels": [
			"gay.xujun05.pocketcrafting.PocketModels"
		]
	},
	"mixins": [
		"pocketcrafting.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabricloader}",
		"halplibe": ">=${halplibe}",
		"minecraft": "*",
		"java": ">=${java}"
	},
	"suggests": {
		"modmenu": ">=${modmenu}"
	}
}
